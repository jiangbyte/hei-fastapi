# hei-fastapi environment example
#
# Keep only deployment/infrastructure settings here.
# Runtime business settings are managed in DB:
# - mail.* and storage.upload_*: sys_config
# - storage provider/endpoint/bucket/access keys: sys_storage_config

APP__HOST=127.0.0.1
APP__PORT=8000
APP__DEBUG=true
APP__PROCESS_ROLE=all
# APP__CONFIG_CRYPTO_KEY=  # required in production (Fernet); used for config + storage AK/SK + file URL signing
# SWAGGER__ENABLED=false   # keep disabled in production
# ID_GENERATOR__WORKER_ID=0  # 0 = auto from hostname/pid; set 1-31 to pin
# AUTH__SESSION_IDLE_TIMEOUT_SECONDS=1800  # 0=disabled; compose defaults to 1800
# AUTH__SESSION_COOKIE_ENABLED=true
# AUTH__SESSION_COOKIE_SECURE=true  # require HTTPS in production
# AUTH__SESSION_COOKIE_SAMESITE=lax
# AUTH__IM_TICKET_TTL_SECONDS=120
# AUTH__MFA_REQUIRED=false  # admin TOTP/WebAuthn; when true, enrollment required before login
# AUTH__MFA_CHALLENGE_TTL_SECONDS=300
# AUTH__MFA_ISSUER=HEI Admin
# AUTH__WEBAUTHN_RP_ID=localhost
# AUTH__WEBAUTHN_RP_NAME=HEI Admin
# AUTH__WEBAUTHN_ORIGIN=http://localhost:5173
# SECRETS__BACKEND=fernet  # or vault
# SECRETS__REQUIRE_VAULT=false
# SECRETS__ALLOW_FERNET_IN_PROD=true  # set false in hardened prod to force Vault
# SECRETS__VAULT_ADDR=http://127.0.0.1:8200
# SECRETS__VAULT_TOKEN=
# SECRETS__VAULT_MOUNT=secret
# SECRETS__VAULT_PATH=hei/fernet
# SECRETS__VAULT_KEY_FIELD=fernet_key
# DR: see docs/dr-checklist.md + docs/dr-drills/ — Postgres PITR / Redis RDB|AOF / quarterly restore drill
APP__CONFIG_CRYPTO_KEY=
APP__TIMEZONE=Asia/Shanghai
APP__TRUSTED_PROXY_IPS=[]
DOCKER_TRUSTED_PROXY_IPS=["172.16.0.0/12","127.0.0.1"]

CORS__ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5163","http://127.0.0.1:5163","http://localhost:5174","http://127.0.0.1:5174"]

# Extra auth-exempt API paths (merged with built-in whitelist). Supports fnmatch (* ?).
# AUTH__AUTH_WHITELIST=["/api/v1/portal/sys/banners/list","/api/v1/custom/*"]

# Local filesystem root for StorageProvider.LOCAL (relative to project root).
# STORAGE__LOCAL_ROOT=.runtime/storage

# Logging / observability (structlog)
# OBSERVABILITY__LOG_ENABLED=true
# OBSERVABILITY__LOG_LEVEL=INFO
# Structured JSON logs (structlog JSONRenderer): OBSERVABILITY__LOG_JSON=true
# OBSERVABILITY__LOG_DIR=logs
# Leave LOG_DIR empty for stdout-only (typical containers): OBSERVABILITY__LOG_DIR=
# OBSERVABILITY__LOG_FILE_MAX_MB=100
# OBSERVABILITY__SERVICE_NAME=hei-fastapi
# OBSERVABILITY__ENVIRONMENT=dev

DB__URL=postgresql+asyncpg://postgres:123456@127.0.0.1:5432/hei_fastapi
# Redis DBs: /0 API cache+result (simple local), /1 Celery broker
# If Redis has requirepass, include it in BOTH URLs, e.g. redis://:password@127.0.0.1:6379/0
REDIS__URL=redis://127.0.0.1:6379/0
CELERY__BROKER_URL=redis://127.0.0.1:6379/1
CELERY__BROKER_VISIBILITY_TIMEOUT=3600
CELERY__WORKER_POOL=solo
CELERY__WORKER_CONCURRENCY=1

# IM dual-channel realtime gateway (same process as FastAPI)
# IM__ENABLED=true
# IM__WS_PORT=18080
# IM__TCP_PORT=18081
# IM__IDLE_SECONDS=90
# Native TCP clients: AUTH first frame then PING/PUSH/ACK on tcp://host:18081

# Optional module plugin controls. Values are comma-separated module/package names.
# Runtime routes/tasks honor these; Alembic still loads disabled modules' models.
# HEI_MODULE_PACKAGES=your_company.modules
# HEI_DISABLED_MODULES=biz.cg_test_activity,biz.cg_test_catalog
# HEI_ENABLED_MODULES=biz.cg_test_activity
